# ============================================================
# Ekuiseo — Caddy DERRIERE un reverse proxy existant (serveur partage)
# ============================================================
# Cas d'usage : un nginx (ou autre) occupe deja les ports 80/443 de l'hote pour
# une autre application. Caddy ne fait alors ni TLS ni ecoute publique : il
# repond en HTTP simple sur le port 80 DU CONTENEUR, publie uniquement sur
# 127.0.0.1:${EKUISEO_HTTP_PORT} (voir docker-compose.vps.yml), et c'est le
# nginx de l'hote qui termine le TLS pour ekuiseo.com et relaie vers ce port
# (voir deploy/nginx/ekuiseo.com.conf).
#
# Le routage et les en-tetes sont identiques au Caddyfile principal ; seuls
# changent l'adresse du site (:80, pas de domaine, pas d'ACME). HSTS est pose
# ici aussi : le nginx amont ne l'ajoute pas et l'en-tete le traverse tel quel.
# ============================================================

{
	auto_https off
	# API d administration fermee (constat F445) : rien ne la consomme, le healthcheck
	# du conteneur interroge :80 (voir docker-compose.prod.yml).
	admin off
}

:80 {
	encode zstd gzip

	header {
		# HSTS : 1 an, sous-domaines compris (tous servis en HTTPS par le nginx amont).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(self)"
		# CSP (constat F403) : connect-src et img-src limites aux hotes reellement
		# contactes par le navigateur (API du site, tuiles MapTiler, widget Kkiapay).
		# Ajouter ici tout futur hote de photos ou de collecte d erreurs.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.kkiapay.me; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.maptiler.com; font-src 'self' data:; connect-src 'self' https://api.maptiler.com https://*.kkiapay.me; worker-src 'self' blob:; frame-src https://*.kkiapay.me; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	# Apercu de partage (constat F341) : les robots de WhatsApp, Facebook, Twitter,
	# Telegram et LinkedIn ne lisent pas l application React ; ils recoivent la page
	# HTML minimale du backend (GET /share/trips/{id}, balises Open Graph), qui
	# redirige les humains vers /trips/{id}.
	@sharebots {
		path /trips/*
		header_regexp User-Agent (?i)(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot)
	}
	handle @sharebots {
		rewrite * /share{path}
		reverse_proxy backend:8080
	}
	handle /share/trips/* {
		reverse_proxy backend:8080
	}

	handle /api/* {
		reverse_proxy backend:8080 {
			# Identifiant de correlation (constat F439) : repris dans le MDC du backend et
			# renvoye au client en X-Request-Id pour rapprocher un ticket d une trace.
			header_up X-Request-Id {http.request.uuid}
			# X-Real-IP est pose par le nginx amont depuis $remote_addr (non forgeable) et
			# traverse Caddy tel quel : NE PAS le reecrire depuis X-Forwarded-For, dont le
			# premier element est controle par le client (constats F008/F428 de l'audit).
			# Le backend lit X-Real-IP en priorite (RateLimitingFilter#clientIp).
			health_uri /actuator/health
			health_interval 15s
			health_timeout 5s
		}
	}

	# Sonde de disponibilite (UP/DOWN seulement pour un appelant anonyme, voir
	# SecurityConfig) : cible des verifications post-deploiement et de la surveillance
	# externe. Le reste de /actuator/* n'est pas expose.
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# Swagger / OpenAPI ne sont plus relayes en production (SPRINGDOC_ENABLED=false
	# cote backend) : la surface d'API n'est pas publique.

	handle {
		reverse_proxy frontend:80
	}

	log {
		output stdout
		format json
	}
}
