# ============================================================
# Ekuiseo — variables d'environnement
# ============================================================
# Copier ce fichier en ".env" (a la racine du depot, a cote de docker-compose.yml)
# puis completer les valeurs. Ne jamais committer le ".env" reel (voir .gitignore).
#
#   cp .env.example .env
#
# Les valeurs par defaut indiquees ici (dans les commentaires) sont celles utilisees
# par docker-compose.yml (dev) quand la variable est absente — ce sont aussi celles
# codees dans backend/src/main/resources/application.yml ; c'est ce fichier qui fait
# foi en cas de doute. En PRODUCTION (docker-compose.prod.yml), DB_PASSWORD,
# JWT_SECRET, DOMAIN et ACME_EMAIL sont OBLIGATOIRES : leur absence fait echouer le
# demarrage plutot que de tomber sur une valeur par defaut faible.
# ============================================================


# ----------------------------------------------------------------------------
# BASE DE DONNEES (PostgreSQL + PostGIS)
# ----------------------------------------------------------------------------
# Lu par application.yml (spring.datasource.*). En docker-compose, DB_HOST/DB_PORT
# sont fixes au nom du service ("postgis") pour le backend ; DB_PORT n'est utile ici
# que pour choisir le port publie a l'hote en dev (docker-compose.yml).

# Nom de la base de donnees. Doit correspondre entre postgis (POSTGRES_DB) et le
# backend (spring.datasource.url) : docker-compose s'en charge automatiquement.
DB_NAME=ekuiseo

# Utilisateur PostgreSQL applicatif.
DB_USER=ekuiseo

# Mot de passe PostgreSQL. OBLIGATOIRE et a changer en production (ex: openssl rand
# -base64 32). Ne jamais utiliser la valeur ci-dessous ailleurs qu'en local.
DB_PASSWORD=ekuiseo_dev_change_me

# Port PostgreSQL publie sur l'hote en dev (docker-compose.yml uniquement ; non utilise
# en production, la base n'y est jamais exposee).
DB_PORT=5432


# ----------------------------------------------------------------------------
# SECURITE / JWT
# ----------------------------------------------------------------------------
# Lu par ekuiseo.jwt.* dans application.yml (JwtService).

# Cle secrete HMAC (algorithme HS256) servant a signer les jetons JWT (acces et
# rafraichissement). DOIT faire au moins 32 caracteres (JwtService refuse de demarrer
# sinon, plutot que d'affaiblir silencieusement la cle). A regenerer pour chaque
# environnement, notamment avant la mise en production, avec par exemple :
#   openssl rand -base64 48
# Attention : changer cette valeur invalide immediatement tous les jetons deja emis
# (tous les utilisateurs connectes devront se reconnecter).
# Volontairement VIDE : aucune valeur d exemple n est acceptee (JwtService refuse
# "change-me...", docker-compose.prod.yml et deploy-vps.sh exigent une valeur). En
# developpement, docker-compose.yml fournit une cle jetable si celle-ci est absente.
JWT_SECRET=

# Duree de vie du jeton d'acces, en minutes.
JWT_ACCESS_TTL_MIN=60

# Duree de vie du jeton de rafraichissement, en jours.
JWT_REFRESH_TTL_DAYS=30

# Duree ABSOLUE d une session, en jours : au-dela, plus aucune rotation du jeton de
# rafraichissement, il faut se reconnecter (V11, RefreshTokenService).
JWT_REFRESH_ABSOLUTE_TTL_DAYS=90


# ----------------------------------------------------------------------------
# FRAIS DE SERVICE
# ----------------------------------------------------------------------------
# Lu par ekuiseo.fee.* (FeePolicy/MoneyUtils). Parametres commerciaux : a ne changer
# qu'en connaissance de cause, avec l'accord de qui fixe la politique tarifaire.

# Taux de commission preleve sur chaque reservation payee (0.08 = 8 %).
SERVICE_FEE_RATE=0.08

# Palier d'arrondi (en FCFA) des frais de service, toujours arrondis AU-DESSUS
# (ex : un palier de 5 arrondit 62 -> 65).
FEE_ROUNDING_STEP=5

# Paiement fractionne (migration V7, regle metier n.21) : depuis cette version,
# une reservation MOMO_DEPOSIT (mode par defaut) ne preleve en ligne qu'un
# ACOMPTE, le solde etant regle en especes au conducteur pendant le trajet.
# BOOKING_DEPOSIT_BASE_FCFA est le plancher (en FCFA) de cet acompte : le
# montant reellement preleve est max(ce plancher, frais de service de la
# reservation), arrondi au palier FEE_ROUNDING_STEP superieur, puis plafonne
# au montant total de la reservation (voir FeePolicy#computeDepositAmount).
# Parametre commercial : a ne changer qu'en connaissance de cause.
BOOKING_DEPOSIT_BASE_FCFA=1000


# ----------------------------------------------------------------------------
# KKIAPAY (agregateur de paiement mobile money : MTN MoMo, Moov Money, Celtiis Cash)
# ----------------------------------------------------------------------------
# Lu par ekuiseo.kkiapay.* dans application.yml (KkiapayConfig/PaymentService). Cles
# obtenues depuis le tableau de bord marchand Kkiapay : https://app.kkiapay.me
# (section "Cles API" pour les 3 cles, section "Webhook" pour le secret de webhook).
# Kkiapay fournit des cles de TEST (sandbox) et des cles de PRODUCTION distinctes :
# ne jamais melanger les deux.

# Implementation utilisee pour parler a Kkiapay : "stub" (par defaut) simule un
# paiement toujours reussi, SANS appeler Kkiapay — pratique en developpement/CI, mais
# ne doit JAMAIS rester actif en production (aucun vrai paiement n'est verifie). "http"
# appelle reellement l'API Kkiapay et exige les 3 cles ci-dessous (le backend refuse de
# demarrer en mode http si l'une d'elles est vide).
KKIAPAY_MODE=stub

# Cle publique Kkiapay (utilisee cote frontend pour initier un paiement, et transmise
# en en-tete par le backend en mode http).
KKIAPAY_PUBLIC_KEY=

# Cle privee Kkiapay (utilisee cote backend pour verifier/confirmer une transaction
# aupres de l'API Kkiapay). A garder strictement secrete.
KKIAPAY_PRIVATE_KEY=

# Cle secrete Kkiapay ("x-secret-key"), transmise avec chaque appel a l'API Kkiapay
# en mode http (distincte du secret de webhook ci-dessous). A garder strictement
# secrete.
KKIAPAY_SECRET=

# Secret de signature du WEBHOOK Kkiapay (menu "Webhook" du tableau de bord Kkiapay,
# distinct des 3 cles d'API ci-dessus) : sert a verifier que les notifications de
# paiement recues sur /api/v1/payments/kkiapay/webhook proviennent bien de Kkiapay
# (en-tete X-Kkiapay-Secret). Sans cette valeur, le webhook refuse toute notification.
KKIAPAY_WEBHOOK_SECRET=

# "true" pour utiliser l'environnement de test (bac a sable) Kkiapay, "false" pour les
# paiements reels. Mettre "false" uniquement avec KKIAPAY_MODE=http et des cles de
# PRODUCTION valides.
KKIAPAY_SANDBOX=true


# ----------------------------------------------------------------------------
# CORS (origines autorisees a appeler l'API depuis un navigateur)
# ----------------------------------------------------------------------------
# Liste separee par des virgules. "*" (defaut) convient au developpement ; en
# production, restreindre au domaine public, plus la vitrine GitHub Pages si elle
# est conservee. Ex. : https://ekuiseo.com,https://akouedekon.github.io
# (Le jeton voyage en en-tete Authorization : l API n autorise jamais les cookies
# en CORS, meme avec "*".)
CORS_ALLOWED_ORIGINS=*


# ----------------------------------------------------------------------------
# EXPLOITATION (documentation d API, journaux, sauvegardes hors site)
# ----------------------------------------------------------------------------
# Swagger UI et /v3/api-docs : true en developpement, false en production
# (docker-compose.prod.yml force false par defaut ; Caddy ne relaie plus ces chemins).
SPRINGDOC_ENABLED=true

# Journaliser les codes de connexion EN CLAIR quand MAIL_MODE/SMS_MODE=log. Confort de
# developpement (docker-compose.yml le pose a true) ; jamais en production, ou les
# destinataires sont masques et les codes remplaces par des etoiles.
OTP_LOG_PLAIN_CODES=false

# Derogation de recette : autoriser MAIL_MODE=log alors que KKIAPAY_MODE=http. Sans
# elle, le backend refuse de demarrer (aucun code de connexion ne partirait).
EKUISEO_ALLOW_LOG_GATEWAYS=false

# Copie hors site des sauvegardes (scripts/backup.sh) : destination rclone, ex.
# "b2:ekuiseo-backups" (Backblaze B2) ou "s3:ekuiseo-backups/prod". Configurer une
# fois sur l hote : apt install rclone && rclone config. Vide = sauvegardes locales
# uniquement (le script l ecrit en avertissement a chaque execution).
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30


# ----------------------------------------------------------------------------
# E-MAIL (envoi des codes de connexion) - canal principal
# ----------------------------------------------------------------------------
# Le code de connexion a 6 chiffres part a l adresse e-mail du compte (obligatoire a
# l inscription). MAIL_MODE=log (defaut) journalise l e-mail au lieu de l envoyer : le
# code se lit dans les logs (docker logs ekuiseo-backend | grep MAIL-STUB). MAIL_MODE=smtp
# envoie reellement via le relais SMTP ci-dessous. Fonctionne avec tout relais authentifie :
#  - Brevo (gratuit, 300 e-mails/jour, aucun dossier d entreprise) : MAIL_HOST=smtp-relay.brevo.com,
#    MAIL_PORT=587, MAIL_USERNAME=identifiant SMTP affiche dans Brevo > SMTP & API,
#    MAIL_PASSWORD=cle SMTP generee au meme endroit, MAIL_FROM=adresse validee dans Brevo.
#  - Gmail : MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=votre adresse Gmail,
#    MAIL_PASSWORD=mot de passe d application (compte Google > Securite > validation en
#    deux etapes > mots de passe des applications), MAIL_FROM=la meme adresse.
MAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Port 587 = STARTTLS (MAIL_SMTP_STARTTLS=true, MAIL_SMTP_SSL=false). Port 465 = TLS implicite
# (Hostinger smtp.hostinger.com, OVH...) : MAIL_PORT=465, MAIL_SMTP_SSL=true, MAIL_SMTP_STARTTLS=false.
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL=false
# Canal des codes : email (defaut) ou sms. OTP_SMS_FALLBACK=true envoie par SMS aux comptes
# sans adresse e-mail (sinon 400 explicite) ; n a de sens qu avec SMS_MODE=http.
OTP_CHANNEL=email
OTP_SMS_FALLBACK=false

# ----------------------------------------------------------------------------
# SMS (envoi des codes de verification OTP par telephone)
# ----------------------------------------------------------------------------
# Lu par ekuiseo.sms.* dans application.yml (SmsConfig/SmsService).

# Implementation utilisee pour envoyer les SMS : "log" (par defaut) journalise le code
# OTP dans les logs du backend AU LIEU DE l'envoyer — acceptable en developpement,
# A NE JAMAIS FAIRE en production (voir docs/CONFORMITE.md). "http" appelle un
# fournisseur SMS HTTP configurable ci-dessous.
SMS_MODE=log

# Fournisseur utilise quand SMS_MODE=http : smspartner | twilio | africastalking | generic.
SMS_PROVIDER=smspartner

# --- smspartner (smspartner.fr / smspartner.africa) : inscription gratuite en libre-service,
# sans dossier d entreprise, SMS offerts a l ouverture, paiement carte ou PayPal, couvre MTN et
# Moov Benin. Cle API : tableau de bord > API. SMSPARTNER_SENDER = nom d expediteur (3 a 11
# caracteres alphanumeriques, facultatif). SMSPARTNER_SANDBOX=true valide sans envoyer ni debiter.
SMSPARTNER_API_KEY=
SMSPARTNER_SENDER=Ekuiseo
SMSPARTNER_SANDBOX=false

# --- twilio : console.twilio.com > Account Info. TWILIO_FROM = numero Twilio (+1...)
# ou identifiant alphanumerique approuve (ex. "Ekuiseo"). Un compte d essai n envoie
# qu aux numeros verifies dans la console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- africastalking : account.africastalking.com > Settings > API Key. AT_SANDBOX=true
# utilise le bac a sable (nom d utilisateur force a "sandbox", SMS visibles dans le
# simulateur). AT_SENDER_ID = identifiant expediteur approuve, facultatif.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# --- generic : URL du fournisseur (POST JSON {"to","message"}, Authorization: Bearer)
# et sa cle. SMS_HTTP_URL sert aussi d URL de base de remplacement pour twilio/africastalking.
SMS_HTTP_URL=
SMS_PROVIDER_KEY=

# Nombre maximal de tentatives de verification d'un meme code OTP avant qu'il soit
# invalide (protection contre le brute-force d'un code a 4-6 chiffres).
OTP_MAX_ATTEMPTS=5

# Anti-abus : nombre maximal de demandes d'envoi d'OTP...
OTP_RATE_LIMIT_MAX_REQUESTS=3
# ...par fenetre glissante de cette duree, en minutes (evite qu'un numero ne
# declenche un envoi de SMS en boucle, ce qui a un cout reel chez le fournisseur SMS).
OTP_RATE_LIMIT_WINDOW_MINUTES=10


# ----------------------------------------------------------------------------
# ALERTES DE RECHERCHE
# ----------------------------------------------------------------------------
# Lu par ekuiseo.search-alert.radius-km. Rayon (en kilometres) autour de l'origine et
# de la destination enregistrees dans une alerte, utilise pour decider si un nouveau
# trajet publie doit declencher une notification a l'utilisateur qui a cree l'alerte.
SEARCH_ALERT_RADIUS_KM=10


# ----------------------------------------------------------------------------
# TRACES DE RECHERCHE (indicateurs de liquidite du back-office)
# ----------------------------------------------------------------------------
# Lu par ekuiseo.search-events.retention-days. Duree de conservation, en jours, des
# traces de recherche (table search_events, migration V9), purgees chaque nuit par
# SearchEventRetentionScheduler. Cette duree est declaree dans docs/CONFORMITE.md
# (section 3.2) : la changer ici impose de l'y mettre a jour.
SEARCH_EVENTS_RETENTION_DAYS=180


# ----------------------------------------------------------------------------
# REVERSEMENTS CONDUCTEUR (mobile money)
# ----------------------------------------------------------------------------
# Lu par ekuiseo.payout.minimum-threshold-fcfa. Montant minimal (en FCFA) que doit
# atteindre le solde d'un conducteur avant qu'un lot de reversement puisse etre
# constitue en sa faveur (evite de multiplier les tout petits virements mobile money,
# qui ont un cout de transaction).
PAYOUT_MIN_THRESHOLD_FCFA=2000

# Une reservation n est reversable au conducteur qu une fois le depart passe depuis ce
# delai (heures) et son acompte reellement encaisse (lot 1.2 de l audit).
PAYOUT_ELIGIBILITY_DELAY_HOURS=24

# Tentatives de remboursement Kkiapay (hors transaction, reprise toutes les 5 min) avant
# de basculer le paiement en traitement manuel (/admin/payments).
REFUND_MAX_ATTEMPTS=5


# ----------------------------------------------------------------------------
# ABONNEMENT CONDUCTEUR
# ----------------------------------------------------------------------------
# Lu par ekuiseo.subscription.price-fcfa. Prix mensuel (en FCFA) de l'abonnement
# conducteur optionnel, qui ramene la commission de service a 0 % tant qu'il est
# actif (voir la table driver_subscriptions). Parametre commercial.
SUBSCRIPTION_PRICE_FCFA=2000


# ----------------------------------------------------------------------------
# ANTI-ABUS (limitation de debit)
# ----------------------------------------------------------------------------
# Lu par ekuiseo.rate-limit.*. Protege /api/v1/auth/** (limite l'enumeration de
# comptes et le bourrage d'identifiants) et le webhook Kkiapay (qui est necessairement
# public) contre un afflux anormal de requetes.

# Nombre maximal de requetes d'authentification (connexion, inscription, OTP)...
RATE_LIMIT_AUTH_MAX=20
# ...par fenetre glissante de cette duree, en secondes, par adresse IP appelante.
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Nombre maximal d'appels au webhook Kkiapay...
RATE_LIMIT_WEBHOOK_MAX=120
# ...par fenetre glissante de cette duree, en secondes.
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60


# ----------------------------------------------------------------------------
# BACKEND
# ----------------------------------------------------------------------------

# Port d'ecoute HTTP du backend (a l'interieur du conteneur, et publie sur l'hote
# en dev uniquement — en production le backend n'est joignable que via Caddy).
SERVER_PORT=8080

# Profil Spring actif (SPRING_PROFILES_ACTIVE). Informationnel pour l'instant : le
# backend ne fournit a ce jour qu'un seul application.yml sans fichier de profil
# (application-dev.yml / application-prod.yml n'existent pas), donc cette variable n'a
# aucun effet tant que de tels fichiers ne sont pas ajoutes. Laisser vide.
SPRING_PROFILES_ACTIVE=


# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------

# URL de base de l'API, injectee au moment du build Vite (ARG/ENV VITE_API_URL, voir
# frontend/Dockerfile) puis figee dans les fichiers statiques generes.
#   - En dev (docker-compose.yml)   : http://localhost:8080 (le navigateur appelle
#     directement le backend, exposee sur le port hote).
#   - En production (docker-compose.prod.yml) : laisser VIDE. Le frontend est alors
#     servi par le meme nom de domaine que l'API (via Caddy, qui route /api/* vers le
#     backend), donc des chemins relatifs suffisent — pas besoin de coder le domaine en
#     dur dans le build, ce qui permettrait de changer de domaine sans reconstruire.
VITE_API_URL=http://localhost:8080

# Fond de carte MapLibre, injecte au moment du build Vite (ARG/ENV VITE_MAP_STYLE_URL,
# voir frontend/Dockerfile). Laisser vide tant qu'aucun fournisseur de tuiles n'est
# provisionne : l'application dessine alors un trace schematique plutot qu'une carte
# cassee. Exemple : https://api.maptiler.com/maps/streets/style.json?key=XXX
VITE_MAP_STYLE_URL=

# Adresse de support affichee sur la page de connexion (recuperation de compte quand
# l adresse e-mail n est plus accessible). Injectee au build Vite.
VITE_SUPPORT_EMAIL=contact@ekuiseo.com


# ----------------------------------------------------------------------------
# DOMAINE / TLS (production uniquement — docker-compose.prod.yml + Caddyfile)
# ----------------------------------------------------------------------------

# Nom de domaine public de la plateforme, DOIT deja pointer (enregistrement DNS A/AAAA)
# vers l'adresse IP du VPS avant le premier demarrage de Caddy, sans quoi l'obtention
# du certificat Let's Encrypt echoue. Exemple : ekuiseo.bj ou app.ekuiseo.bj.
DOMAIN=

# Adresse courriel transmise a Let's Encrypt (alertes d'expiration de certificat,
# communications sur le compte ACME). Ne sert a aucun envoi vers vos utilisateurs.
ACME_EMAIL=
