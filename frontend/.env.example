# URL de l'API backend (Spring). Sans slash final.
VITE_API_URL=http://localhost:8080

# Fond de carte MapLibre. Laisser vide tant qu'aucun fournisseur de tuiles
# n'est provisionne : l'application dessine alors un trace schematique plutot
# qu'une carte cassee. Exemple : https://api.maptiler.com/maps/streets/style.json?key=XXX
VITE_MAP_STYLE_URL=

# Donnees de demonstration quand l'API est injoignable (404/501/reseau).
# Mettre 'false' en production pour que les erreurs remontent telles quelles.
VITE_DEMO_FALLBACK=true
