# URL absolue de l'API (sans slash final). Laisser VIDE dans les cas courants :
#  - en production, Caddy sert le front et relaie /api vers le backend ;
#  - en developpement, Vite relaie /api vers VITE_DEV_API_URL (http://localhost:8080 par defaut).
# Ne renseigner que si le front est heberge sur une autre origine que l'API.
VITE_API_URL=

# Backend cible du proxy de developpement (npm run dev).
VITE_DEV_API_URL=http://localhost:8080

# Fond de carte MapLibre. Laisser vide tant qu'aucun fournisseur de tuiles
# n'est provisionne : l'application dessine alors un trace schematique plutot
# qu'une carte cassee. Exemple : https://api.maptiler.com/maps/streets/style.json?key=XXX
VITE_MAP_STYLE_URL=
