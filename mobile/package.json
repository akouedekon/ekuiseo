{
  "name": "ekuiseo-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Ekuiseo — habillage natif Capacitor de la PWA (Android, préparation iOS). Voir docs/MOBILE.md.",
  "license": "UNLICENSED",
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "open:android": "cap open android",
    "assets:sources": "node scripts/generate-sources.mjs",
    "assets": "npm run assets:sources && capacitor-assets generate --android --iconBackgroundColor #0E7C4A --iconBackgroundColorDark #0E7C4A --splashBackgroundColor #F6F6F3 --splashBackgroundColorDark #0D0D0F",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
